<?xml version="1.0" encoding="utf-8"?>
<!--
  Sicherung und Geräteumzug ab Android 12.

  Beides umfasst dieselben Daten: die Trainingsdatenbank und die Einstellungen. Alles andere
  – Zwischenspeicher, temporäre Dateien – bleibt bewusst außen vor.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="mein_training.db" />
        <include domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="mein_training.db" />
        <include domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
