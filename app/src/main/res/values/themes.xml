<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fest dunkles Theme, kein Light Mode. -->
    <style name="Theme.MeinTraining" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/screen_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!--
        Startbild. Die Activity trägt dieses Theme; `installSplashScreen()` schaltet gleich beim
        Starten auf `postSplashScreenTheme` weiter, sodass der Rest der App nichts davon merkt.

        Das Symbol ist ein quadratisches Bild mit durchsichtigem Rand, in dessen Mitte das
        Motiv sitzt. Ab Android 12 schneidet das System das Symbol kreisrund zu, und zwar
        unabhängig davon, wie eine Zeichnung intern aufgebaut ist – eine `layer-list` mit
        kleiner gesetztem Motiv wird dabei einfach mitgedehnt und das Motiv trotzdem
        beschnitten. Bei einem einzelnen quadratischen Bild stimmen die Verhältnisse dagegen
        immer: Das Motiv ist so weit innen, dass seine Diagonale in den sichtbaren Kreis passt
        und die Maske nur Durchsichtiges abschneidet.
    -->
    <style name="Theme.MeinTraining.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/screen_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.MeinTraining</item>
    </style>
</resources>
