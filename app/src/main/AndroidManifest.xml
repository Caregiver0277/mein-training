<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Ende einer Pausenuhr: zweimal vibrieren, auch bei geschlossener App. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        Fuer den LoudnessEnhancer hinter dem Pausenton (siehe RestTimerSound): Er hebt den Ton
        ueber die Aussteuerungsgrenze, und Klangeffekte verlangen dieses Recht. Es wird beim
        Installieren erteilt, ohne Nachfrage beim Benutzer.
    -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!--
        Der Wecker muss auf die Sekunde kommen; ein verschobener beendet die Pause zu spät.
        Ab Android 13 gilt dafür USE_EXACT_ALARM (wird beim Installieren erteilt), darunter
        SCHEDULE_EXACT_ALARM. Beides zusammen deckt alle unterstützten Versionen ab.
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <application
        android:name=".MeinTrainingApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.MeinTraining">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MeinTraining.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Nimmt den Wecker einer abgelaufenen Pausenuhr entgegen. Nicht exportiert: Ihn
            anstoßen darf nur die App selbst, sonst könnte jede andere das Handy vibrieren
            lassen.
        -->
        <receiver
            android:name=".timer.RestTimerReceiver"
            android:exported="false" />

        <!--
            Reicht das Bild des Rückblicks an die App weiter, mit der geteilt wird. Nur Dateien
            aus dem Zwischenspeicher (res/xml/share_paths.xml), nur lesend und nur für diesen
            einen Vorgang freigegeben – eine Berechtigung braucht die App dafür nicht.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>
    </application>

</manifest>
